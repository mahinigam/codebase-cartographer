# Never commit real keys. Copy this to .env locally.
LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# TypeSafe Jev (System One decision model)
TYPESAFE_API_KEY=  # Generate this key at https://console.typesafe.ai/
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Master kill-switch: false disables all Jev calls even with a key present.
JEV_ENABLED=true
# Cap on Jev HTTP calls per scan/summary fan-out (≤ 0 = unlimited).
# JEV_MAX_CALLS_PER_SCAN=500
JEV_BATCH_CONCURRENCY=5

EMBEDDING_PROVIDER=gemini
FALLBACK_EMBEDDING_PROVIDER=ollama
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
SUMMARY_MAX_FILES=120
SUMMARY_MAX_CHARS=4000
SCAN_MAX_FILES=10000
# Per-file byte cap for reads during scanning (≤ 0 disables).
# SCAN_MAX_FILE_BYTES=2000000
# Aggregate cap on distinct repositories in the store (≤ 0 disables).
# SCAN_MAX_REPOSITORIES=50
SCAN_RATE_LIMIT_PER_MINUTE=6
API_TOKEN=

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# Generate a per-deployment password (e.g. openssl rand -base64 24).
# This file ships empty by design; docker compose fails fast without it.
NEO4J_PASSWORD=

ALLOWED_REPO_ROOTS=
CORS_ORIGINS=http://localhost:5173
